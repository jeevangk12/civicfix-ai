APP_ENV=development
APP_NAME=CivicFix AI
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://civicfix_app:replace-with-local-password@127.0.0.1:55432/civicfix_ai
CORS_ORIGINS=http://localhost:5173

SECRET_KEY=replace-with-long-random-secret
JWT_ISSUER=civicfix-ai
JWT_AUDIENCE=civicfix-ai-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional server-side Gemini analysis. Leave the model and key blank to skip it.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
DUPLICATE_RADIUS_METERS=150
DUPLICATE_WINDOW_DAYS=30
DUPLICATE_SIMILARITY_THRESHOLD=0.5

# Optional private evidence storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PILOT_ORGANIZATION_NAME=
PILOT_AREA_NAME=
PUBLIC_MAP_DEFAULT_VISIBILITY=PRIVATE
PUBLIC_LOCATION_GRID_DEGREES=0.01
MAX_UPLOAD_SIZE_MB=5
MAX_IMAGES_PER_COMPLAINT=4
